---
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/components.css';
import '../styles/sections.css';
import '../styles/page-transition.css';
import '../styles/tactile.css';
import PageTransition from '../components/PageTransition.astro';
const { title, description = '', bodyClass = 'strata', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://comics.makingthings.work').href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · Making Things Work</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />{noindex && <meta name="robots" content="noindex" />}<script is:inline src="/scripts/site.js" defer></script><script is:inline src="/scripts/page-transition.js"></script><slot name="head" /></head><body class={bodyClass}><PageTransition /><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/">Comics</a><nav aria-label="Project"><a href="/">Issues</a><a href="https://www.makingthings.work/experiments/">Experiments</a><a href="https://8bit.makingthings.work/">8-bit mixtape</a></nav></header><main id="main"><slot /></main><slot name="footer" /><script is:inline src="/scripts/tactile.js" defer></script><style is:global>.page-column{position:relative;max-width:1440px;margin-inline:auto;padding:48px clamp(20px,5vw,80px)}.page-column.project-intro{padding-top:calc(var(--header-h) + 48px)}.site-header nav{display:flex;gap:24px;align-items:center}.site-header nav a{font-size:14px}.project-intro{padding-top:calc(var(--header-h) + 48px)}@media(max-width:600px){.site-header{gap:12px;padding-inline:16px}.site-header nav{gap:12px}.site-header nav a{font-size:12px}.site-header .brand{font-size:18px}}</style></body></html>