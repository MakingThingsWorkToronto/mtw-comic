---
// The standalone Comic B reader's issue shelf (/comics/): every issue as a cover, in order, from the registry
// (src/data/comic-stories/index.ts), inside the MTW frame (site header and footer). Each cover shows its hook, the
// trouble, never a villain's name. Arrow keys move between covers; on a phone the shelf is a horizontal swipe row.
// noindex; canonical to the homepage.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { comicIssues, artSrc, artPosition } from '../../data/comic-stories/index';
import '../../styles/comic-story.css'; // the Comic Neue faces
---
<BaseLayout title="Comics" description="Making Things Work illustrated comics, listed in issue order, with the original comic demo." noindex agentExclude canonical="/">
  <link slot="head" rel="preload" href="/fonts/comic-neue-700.woff2" as="font" type="font/woff2" crossorigin />
  <div class="shelf">
    <h1 class="shelf__h">The comics.</h1>
    <section aria-labelledby="comic-stories-h">
    <h2 class="shelf__section-h" id="comic-stories-h">The issues.</h2>
    <ol class="shelf__list" data-shelf>
      {comicIssues.map((i) => (
        <li class="shelf__item">
          <a class="cover" href={`/comics/${i.slug}/`}>
            <span class="cover__art"><img src={artSrc(i.cover, i.story)} style={{ objectPosition: artPosition(i.cover) }} alt="" decoding="async" /></span>
            <span class="cover__mast"><span class="cover__no">{i.story.issue}</span></span>
            <span class="cover__title">{i.story.title}</span>
            <span class="cover__villain">{i.hook}</span>
            <span class="cover__read">Read <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
    <p class="shelf__hint"><span class="shelf__hint-key">Use the arrow keys to choose, Enter to read.</span><span class="shelf__hint-tap">Swipe for more issues.</span></p>
    <p class="shelf__demo"><a href="/comics/demo/">Read the original comic demo <span aria-hidden="true">→</span></a></p>
    </section>
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>
<script is:inline>
  // Arrow keys move focus between covers (Home and End jump to the first and last); a focused cover scrolls into view.
  (function () {
    var list = document.querySelector('[data-shelf]'); if (!list) return;
    var covers = Array.prototype.slice.call(list.querySelectorAll('.cover'));
    document.addEventListener('keydown', function (e) {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      var i = covers.indexOf(document.activeElement), n = covers.length, k = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') k = i < 0 ? 0 : Math.min(n - 1, i + 1);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') k = i < 0 ? 0 : Math.max(0, i - 1);
      else if (e.key === 'Home') k = 0; else if (e.key === 'End') k = n - 1;
      if (k < 0) return;
      e.preventDefault(); covers[k].focus(); covers[k].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    });
  })();
</script>
<style>
  .shelf { min-height: 100svh; display: flex; flex-direction: column; padding: calc(var(--header-h) + 24px) var(--page-gutter) 32px; background: #030607; }
  .shelf__h { margin: clamp(22px, 5vh, 56px) 0 6px; font: 700 clamp(34px, 6vw, 72px)/.95 'Comic Neue', var(--display); font-style: italic; text-transform: uppercase; color: var(--paper); -webkit-text-stroke: .03em #000; paint-order: stroke fill; text-shadow: .06em .06em 0 var(--teal); }
  .shelf__section-h { margin: 24px 0 20px; font: 600 clamp(24px, 3vw, 36px)/1.15 var(--display); color: var(--teal-light); }
  .shelf__demo a:hover { color: var(--teal-light); }
  .shelf__demo { margin: 20px 0 0; }
  .shelf__demo a { color: var(--paper); }
  .shelf__list { list-style: none; margin: 0; padding: 4px 2px 10px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px); }
  .cover { position: relative; display: flex; flex-direction: column; height: 100%; aspect-ratio: 2 / 3; padding: 10px; text-decoration: none; color: var(--paper); background: #0b1419; border: 3px solid #000; outline: 2px solid #f2f2ef33; transition: outline-color .2s, transform .25s var(--ease); }
  .cover:hover, .cover:focus-visible { outline: 3px solid var(--teal-light); outline-offset: 0; transform: translateY(-4px); }
  .cover__art { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .cover__art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cover__art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(#030607d9 0, #03060700 32%, #03060700 55%, #030607f2 88%); }
  .cover > span:not(.cover__art) { position: relative; z-index: 1; }
  .cover > span.cover__mast { position: absolute; top: 10px; right: 10px; display: inline-flex; width: max-content; padding: 6px 8px; background: #030607; border: 2px solid var(--paper); }
  .cover__no { font: 700 14px/1 'Comic Neue', var(--display); text-transform: uppercase; color: #d9b23a; }
  .cover__title { margin-top: auto; font: 700 clamp(20px, 2vw, 30px)/1 'Comic Neue', var(--display); text-transform: uppercase; -webkit-text-stroke: .04em #000; paint-order: stroke fill; text-shadow: .06em .06em 0 #000; }
  .cover__villain { margin-top: 8px; align-self: flex-start; padding: 4px 8px; background: #d9b23a; color: #0a0a0a; border: 2px solid #000; font: 700 13px/1.1 'Comic Neue', var(--display); text-transform: uppercase; }
  .cover__read { margin-top: 10px; font: 600 14px/1 var(--body); color: var(--teal-light); }
  .shelf__hint { margin: auto 0 0; padding-top: 18px; color: var(--muted); font-size: 13px; }
  .shelf__hint-tap { display: none; }
  @media (max-width: 900px) {
    .shelf__list { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(72vw, 300px); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
    .shelf__list::-webkit-scrollbar { display: none; }
    .shelf__item { scroll-snap-align: center; }
    .shelf__hint-key { display: none; } .shelf__hint-tap { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) { .cover { transition: none; } .cover:hover, .cover:focus-visible { transform: none; } }
</style>
