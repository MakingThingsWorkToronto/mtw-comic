---
// The Tracklist (skill: mtw-beat-comic): the site playlist as an 8-bit dialog, the comics' global navigation (Matt,
// 2026-09-28: "make this a component and give the user a button similar to "Skip Intro" to open tracklist on each page
// reveal, this will be the perm way to stay in the 8-bit experience"). The rows are the homepage cover's tracklist
// (src/data/beat-comics/playlist.ts), painted by public/scripts/beat-comic.js in the same marquee style (pixel font,
// teal-light and paper, ink shadow, teal rules, the playing row lit); the real links here lie over the painted rows, so
// the list is keyboard and screen-reader navigation with invisible text, as the ways-in links are. The dock's Tracklist
// button opens it (during the comic and, pinned, after it folds into the page); Escape, the Close button or a click
// outside the list closes it and returns focus to the button. It sits outside the comic's stage so it outlives it.
import type { TracklistRow } from '../data/beat-comics/types';
import { trackLabel } from '../data/beat-comics/tracklist';

interface Props { rows: TracklistRow[] }
const { rows } = Astro.props;
// A track's name says its disc after Disc 1 ("Disc 2, Track 01: ..."), since each disc numbers from 01.
const label = (r: TracklistRow) => (r.no ? `${trackLabel({ disc: r.discNo, no: r.no })}: ${r.title}` : r.title);
---
<div class="rl-tl" id="rl-tracklist" role="dialog" aria-modal="true" aria-labelledby="rl-tl-h" hidden>
  <div class="rl-tl__box">
    <div class="rl-tl__bar">
      <h2 class="rl-tl__h" id="rl-tl-h"><canvas class="rl-px" data-px="TRACKLIST." aria-hidden="true"></canvas><span class="rl-vh">Tracklist</span></h2>
      <button class="rl-tl__close" type="button" data-tactile="press"><canvas class="rl-px" data-px="CLOSE X" aria-hidden="true"></canvas><span class="rl-vh">Close</span></button>
    </div>
    <div class="rl-tl__list">
      <canvas class="rl-tl__px" aria-hidden="true"></canvas>
      <nav class="rl-tl__links" aria-label="Tracklist">
        {rows.map((r, ri) => r.href
          ? <a class="rl-tl__a" href={r.href} data-row={ri}><span class="rl-vh">{label(r)}</span></a>
          : (r.now || !r.disc) && <p class="rl-tl__a rl-tl__a--still" data-row={ri}><span class="rl-vh">{r.now ? `Now playing: ${label(r)}` : label(r)}</span></p>)}
      </nav>
    </div>
  </div>
</div>
