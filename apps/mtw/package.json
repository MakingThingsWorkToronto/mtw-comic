{
  "name": "mtw-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Making Things Work Studio: one local operating surface over the wiki libraries.",
  "scripts": {
    "dev": "tsx server/main.ts --dev",
    "build": "vite build && tsc --noEmit",
    "start": "tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mtw": "tsx cli/mtw.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "0.28.2",
    "node-pty": "1.1.0",
    "preact": "^10.25.0",
    "sharp": "0.35.4",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "mtw": "cli/mtw.mjs"
  }
}
