  "compositionMin": 90,
  "maxBytesPage": 900000,
  "codexStyleMin": 95,
  "codexCompositionMin": 90,
  "codexIdentityMin": 95,
  "deliver": "raster",
  "raster": {
    "_comment": "Matt, 2026-09-28: \"Hi-res image\". Page art is Codex's raster; the engine keeps balloons, borders and lettering vector. Encoded at >= displayWidthCss x dpr (upscaled with Lanczos when the master is narrower; recorded) as WebP and AVIF; the PNG master stays in the library. The vector plates are an optional stage (--retrace).",
    "displayWidthCss": 1440,
    "dpr": 2,
    "webpQuality": 90,
    "avifQuality": 60,
    "print": {
      "enabled": true,
      "colours": 18,
      "kmeans": 4,
      "_comment": "Colour separation after generation. On calibration-xmen137 v6, 20 flat colours took Codex style from 76 to 80 and removed its gradient and glow complaints (2026-09-29)."
    }
  },
  "refPageFirst": true
