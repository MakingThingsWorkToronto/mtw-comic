  "ink": {
    "_comment": "potrace on true ink: luminance < threshold AND chroma <= maxChroma (dark teal flats stay colour); 2x for thin hatching and tapered ends. v10 (2026-09-28): threshold 34 at 1x lost the hatching (calibration-xmen137 t2 read as a posterized poster).",
    "threshold": 80,
    "scale": 2,
    "blur": 0.5,
    "turdsize": 3,
    "alphamax": 1.0,
    "opttolerance": 0.2,
    "precision": 1,
    "maxChroma": 22
  },
  "median": 5,
